---
layout: base.njk
---
{#- Detail page for a project with `detail_page: true`. Body = the Markdown below its front matter. -#}
<div class="detail">
  <a class="text-link back-link" href="/#projects">{% icon "arrow-left" %}<span>{{ site.name }}</span></a>
  <main id="content" tabindex="-1">
    <header class="detail-head">
      <p class="detail-meta">{{ year }}{% if type %}, {{ type }}{% endif %}</p>
      <h1 class="detail-title">{{ title }}</h1>
      {%- if org %}<p class="entry-org">{{ org }}</p>{% endif %}
      {%- if summary %}<p class="lead">{{ summary }}</p>{% endif %}
    </header>
    {%- if thumbnail %}<div class="detail-media">{% thumbnail thumbnail, thumbnail_alt, "(min-width: 44rem) 640px, 100vw" %}</div>{% endif %}
    {%- if contribution %}
    <h2 class="sub-heading">My role</h2>
    <p>{{ contribution }}</p>
    {%- endif %}
    {%- if results and results.length %}
    <h2 class="sub-heading">Results</h2>
    <ul class="bullets results">{% for r in results %}<li>{{ r }}</li>{% endfor %}</ul>
    {%- endif %}
    {%- if content | trim %}<div class="prose">{{ content | safe }}</div>{% endif %}
    {%- if links and links.length %}
    <ul class="link-row">
      {%- for l in links %}<li><a class="text-link" href="{{ l.url }}">{% icon "link" %}<span>{{ l.label }}</span></a></li>{% endfor %}
    </ul>
    {%- endif %}
    {%- if topics and topics.length %}
    <ul class="chips detail-topics" aria-label="Topics">{% for t in topics %}<li>{{ t }}</li>{% endfor %}</ul>
    {%- endif %}
  </main>
</div>
