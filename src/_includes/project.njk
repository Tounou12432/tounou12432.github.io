---
layout: base.njk
---
{#- Detail page for a project with `detail_page: true`. Body = the Markdown below its front matter. -#}
<div class="detail">
  <a class="text-link back-link" href="/#projects">{% icon "arrow-left" %}<span>{{ site.name }}</span></a>
  <main id="content" tabindex="-1">
    <header class="detail-head">
      {%- if type %}<p class="eyebrow">{{ type }}{% if year %} · {{ year }}{% endif %}</p>{% endif %}
      <h1 class="detail-title">{{ title }}</h1>
      {%- if summary %}<p class="lead">{{ summary }}</p>{% endif %}
    </header>
    {%- if thumbnail %}<div class="detail-media">{% thumbnail thumbnail, thumbnail_alt, "(min-width: 44rem) 640px, 100vw" %}</div>{% endif %}
    {%- if contribution %}<p><span class="label">My role:</span> {{ contribution }}</p>{% endif %}
    {%- if results and results.length %}
    <p class="label">Results</p>
    <ul class="bullets">{% for r in results %}<li>{{ r }}</li>{% endfor %}</ul>
    {%- endif %}
    <div class="prose">{{ content | safe }}</div>
    {%- if links and links.length %}
    <ul class="link-row">
      {%- for l in links %}<li><a class="text-link" href="{{ l.url }}">{% icon "link" %}<span>{{ l.label }}</span></a></li>{% endfor %}
    </ul>
    {%- endif %}
  </main>
</div>
