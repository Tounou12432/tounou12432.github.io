{#- "Get in touch" block + social icon row, bottom of the left column. Shows only what site.yaml supplies. -#}
<div class="contact">
  {%- if site.email %}
  <p class="contact-text">Open to conversations about new work. <a class="text-link" href="mailto:{{ site.email }}">Get in touch</a></p>
  {%- else %}
  <p class="contact-text hint">[[Add your email in src/_data/site.yaml to show a “Get in touch” link and email icon]]</p>
  {%- endif %}

  {%- if site.email or site.socials.length %}
  <ul class="socials" aria-label="Contact and profiles">
    {%- for s in site.socials %}
    <li><a href="{{ s.url }}" aria-label="{{ s.label }}" title="{{ s.label }}" rel="me">{% icon "brand:" ~ s.network %}</a></li>
    {%- endfor %}
    {%- if site.email %}
    <li><a href="mailto:{{ site.email }}" aria-label="Email {{ site.email }}" title="Email">{% icon "mail" %}</a></li>
    {%- endif %}
  </ul>
  {%- endif %}
</div>
