---
permalink: /cv/print/
eleventyExcludeFromCollections: true
---
{#- Print-ready CV built from the same data as the site (cv.yaml + site.yaml).
    Source for assets/files/cv.pdf: open this page and Print → Save as PDF, or see README. -#}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>{{ site.name }} — CV</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;500;700&family=Bricolage+Grotesque:opsz,wght@12..96,500..800&display=swap">
  <style>
    @page { size: A4; margin: 16mm 16mm 18mm; }
    :root { --ink: #14202e; --muted: #536173; --gold: #a8761f; --line: #d8dee6; }
    * { box-sizing: border-box; }
    body { margin: 0; color: var(--ink); background: #fff; font: 10pt/1.45 "Atkinson Hyperlegible Next", system-ui, sans-serif; }
    .page { max-width: 178mm; margin: 0 auto; }
    h1 { font: 700 24pt/1.1 "Bricolage Grotesque", sans-serif; letter-spacing: -0.01em; margin: 0; }
    .role { font: 600 12pt/1.3 "Bricolage Grotesque", sans-serif; color: var(--gold); margin: 3pt 0 6pt; }
    .contact { color: var(--muted); margin: 0; }
    .contact a { color: inherit; text-decoration: none; }
    .summary { margin: 10pt 0 0; }
    h2 { font: 700 11.5pt/1.2 "Bricolage Grotesque", sans-serif; margin: 16pt 0 6pt; padding-bottom: 3pt; border-bottom: 1px solid var(--line); break-after: avoid; }
    .item { display: grid; grid-template-columns: 30mm 1fr; gap: 4mm; margin: 0 0 7pt; break-inside: avoid; }
    .date { color: var(--muted); font-size: 9pt; padding-top: 1pt; }
    .title { font-weight: 700; }
    .org { color: var(--muted); }
    p { margin: 1pt 0 0; }
    ul { margin: 2pt 0 0; padding-left: 12pt; }
    li { margin: 0 0 1pt; }
    .skills { display: grid; grid-template-columns: 30mm 1fr; gap: 3pt 4mm; margin: 0; }
    .skills dt { font-weight: 700; }
    .skills dd { margin: 0; }
    @media screen { body { background: #e9edf2; } .page { background: #fff; padding: 16mm; margin: 24px auto; box-shadow: 0 1px 4px rgb(0 0 0 / 0.12); } }
  </style>
</head>
<body>
  <div class="page">
    <h1>{{ site.name }}</h1>
    <p class="role">{{ site.role }}</p>
    <p class="contact">
      {%- if site.location %}{{ site.location }}{% endif %}
      {%- if site.email %} &nbsp;|&nbsp; <a href="mailto:{{ site.email }}">{{ site.email }}</a>{% endif %}
      {%- for s in site.socials %} &nbsp;|&nbsp; <a href="{{ s.url }}">{{ s.url | replace("https://www.", "") | replace("https://", "") }}</a>{% endfor %}
    </p>
    <p class="summary">{{ site.tagline }}</p>

    {%- for sec in cv.sections %}
    <h2>{{ sec.heading }}</h2>
    {%- for job in sec.items %}
    <div class="item">
      <div class="date">{{ job.start }}{% if job.start and job.end %} – {% endif %}{{ job.end }}</div>
      <div>
        <div><span class="title">{{ job.title }}</span>, <span class="org">{{ job.org }}</span></div>
        {%- if job.summary %}<p>{{ job.summary }}</p>{% endif %}
        {%- if job.highlights and job.highlights.length %}<ul>{% for h in job.highlights %}<li>{{ h }}</li>{% endfor %}</ul>{% endif %}
      </div>
    </div>
    {%- endfor %}
    {%- endfor %}

    <h2>Skills</h2>
    <dl class="skills">
      {%- for g in cv.skills %}<dt>{{ g.group }}</dt><dd>{{ g.items | join(", ") }}</dd>{% endfor %}
    </dl>
  </div>
</body>
</html>
