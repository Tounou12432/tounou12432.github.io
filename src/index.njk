---
layout: base.njk
permalink: /
---
{%- set sections = [
  { id: "about", label: "About" },
  { id: "projects", label: "Projects" },
  { id: "cv", label: "CV" }
] -%}
<div class="layout">
  <header class="intro">
    <div>
      {%- if site.photo | fileExists %}
      {% thumbnail site.photo, site.photo_alt or ("Photo of " ~ site.name), "128px", "avatar" %}
      {%- endif %}
      <h1 class="name"><a href="/">{{ site.name }}</a></h1>
      <p class="role">{{ site.role }}</p>
      <p class="tagline">{{ site.tagline }}</p>
      {%- if site.location %}
      <p class="location">{% icon "map-pin" %}<span>{{ site.location }}</span></p>
      {%- endif %}

      <nav class="nav nav-desktop" aria-label="Sections">
        <ul>
          {%- for s in sections %}
          <li><a href="#{{ s.id }}" data-nav><span class="nav-line" aria-hidden="true"></span>{{ s.label }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
    </div>

    {% include "contact.njk" %}
  </header>

  <nav class="nav nav-mobile" aria-label="Sections">
    <ul>
      {%- for s in sections %}
      <li><a href="#{{ s.id }}" data-nav>{{ s.label }}</a></li>
      {%- endfor %}
    </ul>
  </nav>

  <main id="content" tabindex="-1">
    <section id="about" class="section" aria-labelledby="about-heading">
      <h2 id="about-heading" class="section-heading">About</h2>
      <div class="prose">
        {% renderFile "./src/content/about.md" %}
      </div>
    </section>

    <section id="projects" class="section" aria-labelledby="projects-heading">
      <h2 id="projects-heading" class="section-heading">Projects</h2>
      <ol class="entries">
        {#- asyncEach (not for): the card uses the async thumbnail shortcode -#}
        {%- asyncEach p in collections.projects %}
        {% include "project-card.njk" %}
        {%- endeach %}
      </ol>
      <p class="more-link"><a class="text-link" href="/archive/"><span>See all {{ collections.archiveRows.length }} programmes, roles and awards</span>{% icon "arrow-right" %}</a></p>
    </section>

    <section id="cv" class="section" aria-labelledby="cv-heading">
      <div class="section-head">
        <h2 id="cv-heading" class="section-heading">CV</h2>
        {%- if site.cv_pdf | fileExists %}
        <a class="text-link" href="/{{ site.cv_pdf }}" download>{% icon "file-down" %}<span>Download CV <span class="muted">(PDF)</span></span></a>
        {%- else %}
        <p class="hint">[[Download CV link appears once you add src/assets/files/cv.pdf]]</p>
        {%- endif %}
      </div>

      {%- for sec in cv.sections %}
      <h3 class="sub-heading">{{ sec.heading }}</h3>
      <ol class="entries">
        {%- for job in sec.items %}
        <li class="entry reveal">
          <p class="entry-date">{{ job.start }}{% if job.start and job.end %} – {% endif %}{{ job.end }}</p>
          <div class="entry-body">
            <h4 class="entry-title">{{ job.title }}</h4>
            <p class="entry-org">{% if job.url %}<a href="{{ job.url }}">{{ job.org }}</a>{% else %}{{ job.org }}{% endif %}</p>
            {%- if job.summary %}<p>{{ job.summary }}</p>{% endif %}
            {%- if job.highlights and job.highlights.length %}
            <ul class="bullets">
              {%- for h in job.highlights %}<li>{{ h }}</li>{% endfor %}
            </ul>
            {%- endif %}
          </div>
        </li>
        {%- endfor %}
      </ol>
      {%- endfor %}

      <h3 class="sub-heading">Skills</h3>
      <dl class="skills">
        {%- for g in cv.skills %}
        <div class="skill-group">
          <dt>{{ g.group }}</dt>
          <dd><ul class="chips">{% for s in g.items %}<li>{{ s }}</li>{% endfor %}</ul></dd>
        </div>
        {%- endfor %}
      </dl>
    </section>

    <footer class="site-footer">
      <p>Built with <a href="https://www.11ty.dev/">Eleventy</a> and hosted on GitHub Pages. Layout inspired by <a href="https://brittanychiang.com/">Brittany Chiang</a>.</p>
    </footer>
  </main>
</div>
